<%- include('../partials/sidebar') %>

<main class="main-content">

    <%- include('../partials/header', { pageTitle: 'Dashboard' }) %>

    <section class="dashboard-content">

        <div class="welcome-section">
            <div>
                <h2>Welcome to Athlex 👋</h2>
                <p>Here is what's happening with your fitness club today.</p>
            </div>
            <span class="date-label">Admin Overview</span>
        </div>

        <div class="stats-grid">

            <div class="stat-card">
                <span>Total Members</span>
                <h2>1,248</h2>
                <p>Gym community</p>
            </div>

            <div class="stat-card">
                <span>Active Memberships</span>
                <h2>986</h2>
                <p>Currently active</p>
            </div>

            <div class="stat-card">
                <span>Total Products</span>
                <h2>156</h2>
                <p>Available products</p>
            </div>

            <div class="stat-card">
                <span>Total Orders</span>
                <h2>324</h2>
                <p>Shop orders</p>
            </div>

        </div>

        <div class="dashboard-grid">

            <div class="dashboard-card">
                <div class="card-heading">
                    <h3>Recent Members</h3>
                    <a href="/admin/users">View all</a>
                </div>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Membership</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>John Smith</td>
                                <td>Monthly</td>
                                <td><span class="status active">Active</span></td>
                            </tr>
                            <tr>
                                <td>David Lee</td>
                                <td>3 Months</td>
                                <td><span class="status active">Active</span></td>
                            </tr>
                            <tr>
                                <td>Michael Kim</td>
                                <td>Monthly</td>
                                <td><span class="status expired">Expired</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dashboard-card">
                <div class="card-heading">
                    <h3>Recent Orders</h3>
                    <a href="/admin/orders">View all</a>
                </div>

                <div class="order-item">
                    <div>
                        <h4>#ORD-001</h4>
                        <p>Sports T-Shirt</p>
                    </div>
                    <strong>$35.00</strong>
                </div>

                <div class="order-item">
                    <div>
                        <h4>#ORD-002</h4>
                        <p>Protein Shaker</p>
                    </div>
                    <strong>$15.00</strong>
                </div>

                <div class="order-item">
                    <div>
                        <h4>#ORD-003</h4>
                        <p>Gym Gloves</p>
                    </div>
                    <strong>$25.00</strong>
                </div>
            </div>

        </div>

    </section>
</main>